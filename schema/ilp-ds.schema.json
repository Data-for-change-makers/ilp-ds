{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Data-for-change-makers/ilp-ds/main/schema/ilp-ds.schema.json",
  "title": "ILP-DS 0.10-draft: Investment Location Profile-Data Standard",
  "description": "A GeoJSON FeatureCollection of location profiles. Generated by tools/build_schema.py from schema/fields.csv and codelists/; do not edit by hand.",
  "type": "object",
  "required": [
    "type",
    "standard",
    "publisher",
    "licence",
    "base",
    "features"
  ],
  "properties": {
    "@context": {
      "description": "The JSON-LD context, normally schema/ilp-ds.context.jsonld inline, with @base set to the file's base.",
      "type": [
        "object",
        "array",
        "string"
      ]
    },
    "type": {
      "const": "FeatureCollection"
    },
    "standard": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "ILP-DS"
        },
        "version": {
          "const": "0.10-draft"
        }
      }
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "description": "The organisation that publishes the file."
    },
    "licence": {
      "type": "string",
      "minLength": 1,
      "description": "The licence for the file's data, as a URL or SPDX identifier, such as CC-BY-4.0."
    },
    "base": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "description": "The base URI of the records. A record's permanent URI is the base followed by its id."
    },
    "public": {
      "type": "boolean",
      "description": "True for a file meant for publication. tools/check_ilp.py then rejects internal fields and unconsented restricted fields."
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feature"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "ring": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/position"
      }
    },
    "feature": {
      "type": "object",
      "required": [
        "type",
        "id",
        "geometry",
        "properties"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Feature"
        },
        "id": {
          "type": "string",
          "pattern": "^#[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "A fragment identifier, unique in the file, such as #old-oak."
        },
        "geometry": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "Point"
                },
                "coordinates": {
                  "$ref": "#/$defs/position"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "Polygon"
                },
                "coordinates": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/ring"
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "MultiPolygon"
                },
                "coordinates": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/ring"
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "LineString"
                },
                "coordinates": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "$ref": "#/$defs/position"
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "MultiLineString"
                },
                "coordinates": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "$ref": "#/$defs/position"
                    }
                  }
                }
              }
            }
          ]
        },
        "properties": {
          "$ref": "#/$defs/properties"
        }
      }
    },
    "properties": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "entry-date",
        "source"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "opportunity-area",
            "cluster",
            "site",
            "mineral-extraction",
            "infrastructure",
            "building"
          ],
          "description": "The type of record: an area, cluster or site, a mineral extraction site, a building, or a route or network of infrastructure."
        },
        "parent": {
          "type": "string",
          "pattern": "^#[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "The id of the record one level up, in the same file. Required for a building."
        },
        "serves": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^#[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "description": "The ids of the areas, clusters and sites the infrastructure serves or connects, in the same file."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "The record's name."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "A narrative description of up to 400 words."
        },
        "organisation": {
          "type": "string",
          "minLength": 1,
          "description": "The lead body: a Planning Data organisation reference where one exists, otherwise its name."
        },
        "local-authorities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(E0[6-9]|E10|W06|S12|N09)\\d{6}$"
          },
          "description": "The ONS GSS code of each council the record lies in, such as E09000009 for Ealing."
        },
        "planning-authority": {
          "type": "string",
          "pattern": "^[a-z][a-z-]*:[A-Za-z0-9-]+$",
          "description": "The planning authority's Planning Data organisation reference, where it differs from the council, such as development-corporation:Q20648596 for OPDC."
        },
        "opportunity-area": {
          "type": "string",
          "minLength": 1,
          "description": "The name of the GLA Opportunity Area the record lies in, if any."
        },
        "point": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          ],
          "description": "A representative point as [longitude, latitude] in WGS84."
        },
        "hectares": {
          "type": "number",
          "minimum": 0,
          "description": "The area in hectares."
        },
        "ownership-status": {
          "type": "string",
          "enum": [
            "owned by a public authority",
            "not owned by a public authority",
            "mixed ownership",
            "unknown ownership"
          ],
          "description": "Whether a public authority owns the land."
        },
        "planning-references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "The planning authority's application references for the consent or consents."
        },
        "planning-documents-url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "description": "A link to the consent's documents on the planning authority's website."
        },
        "planning-status": {
          "type": "string",
          "enum": [
            "permissioned",
            "not permissioned",
            "pending decision"
          ],
          "description": "Whether the record has planning permission."
        },
        "permission-type": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "full planning permission",
              "outline planning permission",
              "reserved matters approval",
              "permission in principle",
              "technical details consent",
              "planning permission granted under an order",
              "hybrid planning permission",
              "other"
            ]
          },
          "description": "The types of permission the record holds, each listed once, such as a hybrid permission, later reserved matters approvals and a further outline permission. ILP-DS adds hybrid planning permission to the brownfield list and allows more than one type."
        },
        "permission-date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "The date permission was granted. Displays may show the year only."
        },
        "homes-consented": {
          "type": "integer",
          "minimum": 0,
          "description": "The number of homes with planning consent."
        },
        "homes-completed": {
          "type": "integer",
          "minimum": 0,
          "description": "The number of homes built and completed so far. They are part of homes-consented, not in addition to it, so the homes still to come are homes-consented minus homes-completed."
        },
        "floorspace-consented": {
          "type": "object",
          "minProperties": 1,
          "description": "Consented floorspace in square metres, by use class.",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "homes-pipeline": {
          "type": "integer",
          "minimum": 0,
          "description": "The number of homes in the owner's vision beyond those consented, so homes-consented plus homes-pipeline is the total. Never include consented homes. Display as a vision, not a consent."
        },
        "floorspace-pipeline": {
          "type": "object",
          "minProperties": 1,
          "description": "Floorspace in the owner's vision beyond that consented, in square metres by use class. Never include consented floorspace. For a range, the lower figures. Display as a vision, not a consent.",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "floorspace-pipeline-to": {
          "type": "object",
          "minProperties": 1,
          "description": "The upper figures when the source gives a range of pipeline floorspace, such as 45,000 in \"25,000 to 45,000 sqm\", keyed like floorspace-pipeline. Needs floorspace-pipeline.",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "jobs-from": {
          "type": "integer",
          "minimum": 0,
          "description": "The number of jobs the development is expected to support, as the source states it. A single figure goes here; for a range, the lower figure."
        },
        "jobs-to": {
          "type": "integer",
          "minimum": 0,
          "description": "The upper figure when the source gives a range of jobs, such as 25,000 in \"14,000 to 25,000 jobs\". Needs jobs-from."
        },
        "toid": {
          "type": "string",
          "pattern": "^osgb\\d{13,16}$",
          "description": "The Ordnance Survey TOID of an existing building."
        },
        "uprns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\d{1,12}$"
          },
          "description": "The Unique Property Reference Numbers of the addresses."
        },
        "storeys": {
          "type": "integer",
          "minimum": 0,
          "description": "The number of storeys above ground."
        },
        "height-m": {
          "type": "number",
          "minimum": 0,
          "description": "The height above ground in metres."
        },
        "model-tier": {
          "type": "string",
          "enum": [
            "context",
            "massing",
            "realistic",
            "detailed"
          ],
          "description": "The level of detail at which the building is modelled."
        },
        "model-url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "description": "A link to a 3D model or viewer."
        },
        "story-stops": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "The names of the camera views in the 3D model that tell the location's story."
        },
        "designated-area": {
          "type": "boolean",
          "description": "Whether the record lies in a designated opportunity or growth area."
        },
        "designations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "The designations, such as a London Plan Opportunity Area."
        },
        "land-type": {
          "type": "string",
          "enum": [
            "brownfield",
            "brownfield-greyfield",
            "greenfield",
            "mixed",
            "unknown"
          ],
          "description": "Brownfield, greenfield or both."
        },
        "overall-status": {
          "type": "string",
          "enum": [
            "stalled",
            "in-progress",
            "complete"
          ],
          "description": "Whether the development is moving: stalled, in progress or complete."
        },
        "delivery-stage": {
          "type": "string",
          "enum": [
            "visioning",
            "master-planning",
            "masterplan-adopted",
            "committee",
            "consented",
            "construction"
          ],
          "description": "The stage a development in progress has reached, where it is known. Leave empty for a whole area with schemes at several stages."
        },
        "land-assembly": {
          "type": "string",
          "enum": [
            "single-ownership",
            "assembled",
            "partly-assembled",
            "fragmented",
            "unknown"
          ],
          "description": "How far the land has been brought into one ownership. Commercially sensitive: never published."
        },
        "owner-vision": {
          "type": "string",
          "enum": [
            "unknown",
            "emerging",
            "clear"
          ],
          "description": "How clear the owner's vision is. Published only once the owner has seen it."
        },
        "policy-alignment-local": {
          "type": "object",
          "required": [
            "alignment"
          ],
          "additionalProperties": false,
          "properties": {
            "alignment": {
              "type": "string",
              "enum": [
                "aligned",
                "partly-aligned",
                "not-aligned",
                "not-assessed"
              ]
            },
            "policy": {
              "type": "string",
              "minLength": 1
            },
            "assessed-by": {
              "type": "string",
              "minLength": 1
            },
            "assessed-date": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "if": {
            "properties": {
              "alignment": {
                "not": {
                  "const": "not-assessed"
                }
              }
            }
          },
          "then": {
            "required": [
              "policy",
              "assessed-by",
              "assessed-date"
            ]
          },
          "description": "An assessment of the vision against the Local Plan. Published only once the planning authority has seen it."
        },
        "policy-alignment-regional": {
          "type": "object",
          "required": [
            "alignment"
          ],
          "additionalProperties": false,
          "properties": {
            "alignment": {
              "type": "string",
              "enum": [
                "aligned",
                "partly-aligned",
                "not-aligned",
                "not-assessed"
              ]
            },
            "policy": {
              "type": "string",
              "minLength": 1
            },
            "assessed-by": {
              "type": "string",
              "minLength": 1
            },
            "assessed-date": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "if": {
            "properties": {
              "alignment": {
                "not": {
                  "const": "not-assessed"
                }
              }
            }
          },
          "then": {
            "required": [
              "policy",
              "assessed-by",
              "assessed-date"
            ]
          },
          "description": "An assessment of the vision against the regional plan, such as the London Plan. Published only once the planning authority has seen it."
        },
        "policy-alignment-national": {
          "type": "object",
          "required": [
            "alignment"
          ],
          "additionalProperties": false,
          "properties": {
            "alignment": {
              "type": "string",
              "enum": [
                "aligned",
                "partly-aligned",
                "not-aligned",
                "not-assessed"
              ]
            },
            "policy": {
              "type": "string",
              "minLength": 1
            },
            "assessed-by": {
              "type": "string",
              "minLength": 1
            },
            "assessed-date": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "if": {
            "properties": {
              "alignment": {
                "not": {
                  "const": "not-assessed"
                }
              }
            }
          },
          "then": {
            "required": [
              "policy",
              "assessed-by",
              "assessed-date"
            ]
          },
          "description": "An assessment of the vision against national policy (the NPPF). Published only once the planning authority has seen it."
        },
        "asset-classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "commercial",
              "international-education-and-learning",
              "experience-economy",
              "frontier-innovation",
              "living",
              "logistics-and-light-industrial",
              "data-centres",
              "energy-and-decarbonisation",
              "transport",
              "other"
            ]
          },
          "description": "The kinds of asset the location offers investors, in real estate or infrastructure."
        },
        "economic-drivers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "createch",
              "frontier-innovation",
              "advanced-manufacturing",
              "clean-energy",
              "digital",
              "heathrow-linked-industries",
              "creative-tech",
              "immersive-media",
              "design",
              "fashiontech"
            ]
          },
          "description": "The sectors expected to drive demand, starting from WLA's six priority growth sectors."
        },
        "gva-uplift": {
          "type": "number",
          "minimum": 0,
          "description": "The estimated gross value added uplift in pounds a year. Needs gva-method, gva-source and gva-date."
        },
        "gva-method": {
          "type": "string",
          "enum": [
            "gross",
            "net-additional",
            "not-stated"
          ],
          "description": "How the GVA estimate was made: gross, net additional, or not stated by the source."
        },
        "gva-source": {
          "type": "string",
          "minLength": 1,
          "description": "Where the GVA estimate comes from: a link or a citation."
        },
        "gva-date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "The date of the GVA estimate."
        },
        "investment-value": {
          "type": "number",
          "minimum": 0,
          "description": "An investment figure in pounds. Needs value-type, value-source and value-date."
        },
        "value-type": {
          "type": "string",
          "enum": [
            "gdv",
            "invested-to-date",
            "investment-required"
          ],
          "description": "What the investment figure measures."
        },
        "value-source": {
          "type": "string",
          "minLength": 1,
          "description": "Where the investment figure comes from: a link or a citation."
        },
        "value-date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "The date of the investment figure."
        },
        "qualifiers": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "hectares",
              "homes-consented",
              "homes-completed",
              "homes-pipeline",
              "floorspace-consented",
              "floorspace-pipeline",
              "floorspace-pipeline-to",
              "jobs-from",
              "jobs-to",
              "gva-uplift",
              "investment-value"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "about",
              "at-least",
              "up-to"
            ]
          },
          "description": "How to read figures a source gives loosely, such as \"c.£7.5bn\", \"3,000+\" or \"up to 14,000 homes\": a map from the field holding the figure to about, at-least or up-to. A figure not listed is as exact as its source."
        },
        "funding-status": {
          "type": "string",
          "enum": [
            "secured",
            "secured-future-rounds-available",
            "partly-secured",
            "not-secured"
          ],
          "description": "How much of the development's funding is secured. Published only with the owner's agreement."
        },
        "opportunity-types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "joint-venture",
              "development-partnership",
              "capital-investment",
              "forward-funding",
              "land-sale",
              "occupier",
              "other"
            ]
          },
          "description": "How an investor or occupier can take part, such as a joint venture or a lease. Choose all that apply; for anything not listed, choose other and describe it in opportunity-type-notes."
        },
        "opportunity-type-notes": {
          "type": "string",
          "minLength": 1,
          "description": "Free text on how to take part: detail of the chosen types, or a type not in the list. Needed when opportunity-types includes other."
        },
        "contacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "anyOf": [
              {
                "required": [
                  "email"
                ]
              },
              {
                "required": [
                  "url"
                ]
              }
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "email": {
                "type": "string",
                "format": "email",
                "pattern": "^[^@\\s]+@[^@\\s]+$"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              }
            }
          },
          "description": "Where to send enquiries: a named person, a role or a team, with an email address or web page. Anything supplied here is published."
        },
        "investors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
