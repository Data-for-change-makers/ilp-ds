      "@id": "reilp:policyAlignmentNational",
      "@type": "@json"
    },
    "economic-drivers": {
      "@id": "reilp:economicDrivers",
      "@container": "@set"
    },
    "gva-uplift": {
      "@id": "reilp:gvaUplift",
      "@type": "xsd:decimal"
    },
    "gva-method": "reilp:gvaMethod",
    "gva-source": "reilp:gvaSource",
    "gva-date": {
      "@id": "reilp:gvaDate",
      "@type": "xsd:date"
    },
    "investment-value": {
      "@id": "reilp:investmentValue",
      "@type": "xsd:decimal"
    },
    "value-type": "reilp:valueType",
    "value-source": "reilp:valueSource",
    "value-date": {
      "@id": "reilp:valueDate",
      "@type": "xsd:date"
    },
    "funding-status": "reilp:fundingStatus",
    "contacts": {
      "@id": "reilp:contacts",
      "@type": "@json"
    },
    "investors": {
      "@id": "reilp:investors",
      "@type": "@json"
    },
    "model-commissioner": "reilp:modelCommissioner",
