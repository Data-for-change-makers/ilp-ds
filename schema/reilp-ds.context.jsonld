{
  "@context": {
    "@version": 1.1,
    "geojson": "https://purl.org/geojson/vocab#",
    "reilp": "https://dataforchangemakers.org.uk/ns/reilp-ds#",
    "schema": "https://schema.org/",
    "dct": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "type": "@type",
    "id": "@id",
    "FeatureCollection": "geojson:FeatureCollection",
    "Feature": "geojson:Feature",
    "Point": "geojson:Point",
    "Polygon": "geojson:Polygon",
    "MultiPolygon": "geojson:MultiPolygon",
    "features": {
      "@id": "geojson:features",
      "@container": "@set"
    },
    "geometry": "geojson:geometry",
    "coordinates": {
      "@id": "geojson:coordinates",
      "@container": "@list"
    },
    "properties": "@nest",
    "standard": {
      "@id": "dct:conformsTo",
      "@type": "@json"
    },
    "publisher": "dct:publisher",
    "public": null,
    "base": null,
    "changelog": null,
    "kind": "reilp:kind",
    "parent": {
      "@id": "reilp:parent",
      "@type": "@id"
    },
    "name": "schema:name",
    "description": "schema:description",
    "organisation": "reilp:organisation",
    "local-authorities": {
      "@id": "reilp:localAuthorities",
      "@container": "@set"
    },
    "planning-authority": "reilp:planningAuthority",
    "opportunity-area": "reilp:opportunityArea",
    "point": {
      "@id": "reilp:point",
      "@container": "@list"
    },
    "hectares": {
      "@id": "reilp:hectares",
      "@type": "xsd:decimal"
    },
    "ownership-status": "reilp:ownershipStatus",
    "planning-references": {
      "@id": "reilp:planningReferences",
      "@container": "@set"
    },
    "planning-documents-url": {
      "@id": "reilp:planningDocumentsUrl",
      "@type": "@id"
    },
    "planning-status": "reilp:planningStatus",
    "permission-type": "reilp:permissionType",
    "permission-date": {
      "@id": "reilp:permissionDate",
      "@type": "xsd:date"
    },
    "homes-consented": {
      "@id": "reilp:homesConsented",
      "@type": "xsd:integer"
    },
    "floorspace-consented": {
      "@id": "reilp:floorspaceConsented",
      "@type": "@json"
    },
    "homes-pipeline": {
      "@id": "reilp:homesPipeline",
      "@type": "xsd:integer"
    },
    "floorspace-pipeline": {
      "@id": "reilp:floorspacePipeline",
      "@type": "@json"
    },
    "toid": "reilp:toid",
    "uprns": {
      "@id": "reilp:uprns",
      "@container": "@set"
    },
    "storeys": {
      "@id": "reilp:storeys",
      "@type": "xsd:integer"
    },
    "height-m": {
      "@id": "reilp:heightM",
      "@type": "xsd:decimal"
    },
    "model-tier": "reilp:modelTier",
    "model-url": {
      "@id": "reilp:modelUrl",
      "@type": "@id"
    },
    "story-stops": {
      "@id": "reilp:storyStops",
      "@container": "@set"
    },
    "designated-area": {
      "@id": "reilp:designatedArea",
      "@type": "xsd:boolean"
    },
    "designations": {
      "@id": "reilp:designations",
      "@container": "@set"
    },
    "land-type": "reilp:landType",
    "overall-status": "reilp:overallStatus",
    "land-assembly": "reilp:landAssembly",
    "owner-vision": "reilp:ownerVision",
    "policy-alignment-local": {
      "@id": "reilp:policyAlignmentLocal",
      "@type": "@json"
    },
    "policy-alignment-regional": {
