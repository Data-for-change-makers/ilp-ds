      "@id": "schema:startDate",
      "@type": "xsd:date"
    },
    "end-date": {
      "@id": "schema:endDate",
      "@type": "xsd:date"
    },
    "entry-date": {
      "@id": "dct:modified",
      "@type": "xsd:date"
    },
    "source": "dct:source",
